// ABOUTME: hk git hooks that run the checks of upstream GitHub CI, because Actions is off on this fork.
amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"

// Paths that trigger the Distribution contract workflow.
local distributionInputs = List(
  "distribution/**",
  "docs/next/website/**",
  "docs/preview/**",
  "docs/versions/**",
  "scripts/agent_detection_manifest_check.py",
  "scripts/config_reference_check.py",
  "scripts/docs/**",
  "scripts/docs_translation_parity.py",
  "scripts/preview.py",
  "scripts/test_agent_detection_manifest_check.py",
  "scripts/test_config_reference_check.py",
  "scripts/test_docs_translation_parity.py",
  "scripts/test_preview.py",
  "src/detect/manifest_update.rs",
  "src/detect/manifests/**"
)

// Paths that trigger the Nix workflow.
local nixInputs = List(
  "assets/**",
  "build.rs",
  "crates/**",
  "Cargo.lock",
  "Cargo.toml",
  "flake.lock",
  "flake.nix",
  "nix/**",
  "skills/**",
  "vendor/**"
)

// Test fixtures run git, so they must not see this repo (hook GIT_* vars) or the user's git config, as in CI.
local function isolated(command: String): String = "unset $(git rev-parse --local-env-vars) && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \(command)"

hooks {
  ["pre-commit"] {
    fix = false
    // Checks read the working tree, and any stash method uses the stack that all worktrees share.
    stash = "none"
    steps {
      // Upstream's own hook: the release-only SKILL.md guard, then `just lint`.
      ["upstream-pre-commit"] {
        check = ".githooks/pre-commit"
      }
      ["fork-hook-tests"] {
        glob = "hooks/**"
        check = "python3 -m unittest discover -s hooks"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = ".githooks/commit-msg {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    fix = false
    steps {
      // Test steps read the working tree, so they only prove the pushed commits when the tree is clean.
      ["clean-tree"] {
        check = #"test -z "$(git status --porcelain)" || { echo "commit or stash local changes before push"; git status --short; exit 1; }"#
      }
      // Timing-sensitive tests fail when other sessions saturate the CPUs, so the run starts only at low load.
      ["low-load"] {
        check = "hooks/wait_for_low_load.py"
      }
      // The macOS job of the CI workflow, with its test filter.
      ["ci"] {
        depends = "low-load"
        // Timing-sensitive server tests fail when 18 run at once on a shared Mac; CI runners have about 3 cores.
        env { ["NEXTEST_TEST_THREADS"] = "6" }
        check = isolated("just ci 'not binary(live_handoff)'")
      }
      ["distribution-contract"] {
        glob = distributionInputs
        check = isolated("""
          bun test scripts/docs/*.test.ts \
          && python3 scripts/agent_detection_manifest_check.py --require-published \
          && python3 scripts/config_reference_check.py \
          && python3 scripts/docs_translation_parity.py --docs-root docs/next/website/src/content/docs \
          && node scripts/docs/versions.mjs check \
          && node scripts/docs/preview.mjs check \
          && python3 -m unittest scripts.test_agent_detection_manifest_check scripts.test_config_reference_check scripts.test_docs_translation_parity scripts.test_preview
          """)
      }
      ["nix-flake"] {
        profiles = List("slow")
        glob = nixInputs
        check = isolated("nix flake check --print-build-logs && nix flake check --all-systems --no-build --print-build-logs")
      }
      // The Linux-only CI step for libghostty runtime safety.
      ["libghostty-scalar-safety"] {
        profiles = List("slow")
        depends = "ci"
        env {
          ["LIBGHOSTTY_VT_SIMD"] = "false"
          ["LIBGHOSTTY_VT_OPTIMIZE"] = "ReleaseSafe"
          // A separate target dir keeps the scalar build from evicting the normal ghostty-vt build.
          ["CARGO_TARGET_DIR"] = "target/scalar-safety"
        }
        check = isolated("cargo nextest run --locked -E 'package(ghostty-vt) | test(ghostty)' --status-level fail --final-status-level fail --failure-output final --success-output never")
      }
    }
  }
}
